{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "aiwf ai-report",
  "description": "Contrato del reporte agregado de ci-parity (findings unificados y redactados).",
  "type": "object",
  "required": ["schemaVersion", "project", "tools", "counts", "findings"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "project": { "type": "string", "minLength": 1 },
    "tools": { "type": "array", "items": { "type": "string" } },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "ruleId", "severity", "message", "category"],
        "properties": {
          "tool": { "type": "string" },
          "ruleId": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "message": { "type": "string", "description": "Redactado: nunca contiene el secreto/código crudo." },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 0 },
          "category": { "type": "string", "enum": ["secret", "sast", "sca", "sbom", "vuln"] }
        }
      }
    }
  }
}
