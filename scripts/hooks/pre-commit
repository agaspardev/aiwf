#!/usr/bin/env sh
# pre-commit — fast, deterministic gate. gofmt + go vet on what you are about
# to commit. Cheap checks that catch the exact drift that bit commit 03172be
# ("gofmt drift"). Coverage is NOT here (too slow per-commit) — it lives in
# scripts/coverage-gate.sh, run by CI / quality-gate.
#
# Enable once per clone:  git config core.hooksPath scripts/hooks
set -eu

# 0) Containment (F2) — runs ALWAYS: no work artifact (scratch/notes/evidence/
# reports/screenshots/playwright-report/coverage/handoffs dirs, coverage.out,
# lcov.info, *.cov, *.log) may be staged outside .ai-workflow/. Fast shell check
# on staged paths (the authoritative Go scan runs in CI). allowlist-aware.
staged_all=$(git diff --cached --name-only --diff-filter=ACM || true)
if [ -n "$staged_all" ]; then
  bad=$(printf '%s\n' "$staged_all" \
    | grep -Ev '^\.ai-workflow/' \
    | grep -E '(^|/)(scratch|notes|evidence|reports|screenshots|playwright-report|coverage|handoffs)/|(^|/)(coverage\.out|lcov\.info)$|\.(cov|log)$' \
    || true)
  if [ -n "$bad" ] && [ -f scripts/containment-allow.txt ]; then
    allowtmp=$(mktemp)
    grep -vE '^[[:space:]]*(#|$)' scripts/containment-allow.txt > "$allowtmp" 2>/dev/null || true
    if [ -s "$allowtmp" ]; then
      bad=$(printf '%s\n' "$bad" | grep -vxF -f "$allowtmp" || true)
    fi
    rm -f "$allowtmp"
  fi
  if [ -n "$bad" ]; then
    echo "pre-commit: containment — artefactos de trabajo fuera de .ai-workflow/:" >&2
    printf '  %s\n' "$bad" >&2
    echo "  movelos bajo .ai-workflow/ (o allowlistealos con justificación)" >&2
    exit 1
  fi
fi

# Staged Go files (added/copied/modified), excluding deletions.
staged=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
if [ -z "$staged" ]; then
  echo "pre-commit: containment OK"
  exit 0
fi

# 1) gofmt — list files that are not formatted. Deterministic, no build.
unformatted=$(printf '%s\n' "$staged" | xargs gofmt -l 2>/dev/null || true)
if [ -n "$unformatted" ]; then
  echo "pre-commit: gofmt needed on:" >&2
  printf '  %s\n' "$unformatted" >&2
  echo "  run: gofmt -w <files>  (then re-stage)" >&2
  exit 1
fi

# 2) go vet — static analysis (not a production build) on the whole module.
if ! vetout=$(go vet ./... 2>&1); then
  echo "pre-commit: go vet failed:" >&2
  echo "$vetout" >&2
  exit 1
fi

# 3) arch-gate — el núcleo puro (internal/workspace) debe seguir I/O-free.
#    Barato (go list); atrapa una regresión de arquitectura antes del commit.
if ! archout=$(sh scripts/arch-gate.sh 2>&1); then
  echo "$archout" >&2
  exit 1
fi

echo "pre-commit: gofmt + vet + arch OK"
