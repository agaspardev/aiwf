# OmniRoute Environment Variables
# Copiar este archivo a: C:\Users\anton\.omniroute\.env
# Reemplazar los valores con las credenciales reales

# Clave de encriptación del storage SQLite (generada al instalar)
STORAGE_ENCRYPTION_KEY=tu-storage-encryption-key-aqui

# API key de OmniRoute para autenticación del dashboard y endpoints
# Generar con: omniroute api-keys create
OMNIROUTE_API_KEY=tu-api-key-aqui
